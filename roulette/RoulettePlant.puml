@startuml

actor Player

package "Roulette Backend : 8081" as RouletteBackend {

    component "RouletteController" as Controller
    component "RouletteServiceImpl" as Service
    component "RouletteEngine" as Engine
    component "RouletteInfoService" as Info
    component "RouletteStatsCalculator" as Stats
    component "RouletteGameRepository" as Repo
    database "Roulette DB" as DB

    component "BankingRestClient" as BankingClient

    component "RouletteBetStrategyResolver" as Resolver
    component "Bet Strategies" as Strategies

    Controller --> Service : delegates requests

    Service --> Engine : play round
    Service --> Info : rules / chances
    Service --> Stats : calculate stats
    Service --> Repo : save / read games
    Service --> BankingClient : validate user\ncreate transaction

    Engine --> Resolver : resolve bet type
    Info --> Resolver : RTP / house edge
    Resolver --> Strategies : selects strategy

    Repo --> DB : persist games
}

cloud "Banking Service : 8080" as BankingService

Player --> Controller : HTTP\nplay / info / stats
BankingClient --> BankingService : HTTP\nuser / transaction

@enduml